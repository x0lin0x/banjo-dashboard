# Trading Dashboard backend environment example
# Copy to .env and adjust values for your setup.

# Runtime
APP_ENV=development
APP_ROLE=viewer
APP_READ_ONLY=true

# Sync security
# In APP_ENV != development, use a token >= 32 chars.
SYNC_API_TOKEN=change-me-with-a-strong-random-token
SYNC_MIN_INTERVAL_SECONDS=5

# Data source
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com

# Database
# Local sqlite (default)
DATABASE_URL=sqlite:///./trading.db
# Postgres example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/trading
